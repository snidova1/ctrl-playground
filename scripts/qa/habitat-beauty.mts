import {chromium} from '@playwright/test';
import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
const origin=process.env.CTRL_QA_ORIGIN??'http://127.0.0.1:3242';
const dir=`test-results/habitat-beauty/${new URL(origin).hostname==='127.0.0.1'?'source':'live'}`;
await mkdir(dir,{recursive:true});
const browser=await chromium.launch({executablePath:'/home/celeng/.cache/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell',args:['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-dev-shm-usage']});
const checks:string[]=[],errors:string[]=[];
try{
 for(const mobile of [true,false]){
  const label=mobile?'phone':'desktop';
  const context=await browser.newContext({viewport:mobile?{width:390,height:760}:{width:1440,height:1000},isMobile:mobile,hasTouch:mobile});
  const p=await context.newPage();p.setDefaultTimeout(45000);p.on('pageerror',e=>errors.push(e.message));
  await p.goto(origin+'/habitat-test',{waitUntil:'domcontentloaded'});
  await p.waitForFunction(()=>document.documentElement.dataset.ctrlHouseReady==='true'&&Number(document.documentElement.dataset.ctrlAvatarMeshCount)>0);
  await p.getByRole('button',{name:'Perabot',exact:true}).click();
  await p.getByRole('button',{name:'Save & play',exact:true}).click();
  const before=await p.evaluate(()=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!));
  await p.getByRole('button',{name:'Perabot',exact:true}).click();
  await p.getByRole('group',{name:'Curated collections'}).waitFor();
  await p.waitForFunction(()=>Array.from(document.querySelectorAll<HTMLImageElement>('.hb-build-asset-art img')).slice(0,3).every(img=>img.complete&&img.naturalWidth>0));
  await p.screenshot({path:`${dir}/catalog-${label}.png`});
  await p.getByRole('button',{name:'Browse Rainy-day reading',exact:true}).click();
  assert.equal(await p.getByRole('button',{name:'Add Books',exact:true}).count(),1);
  assert.equal(await p.evaluate(()=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!).objects.length),before.objects.length);
  await p.getByRole('button',{name:'Clear collection filter',exact:true}).click();
  await p.getByRole('button',{name:'Show pieces already in your world',exact:true}).click();
  assert.equal(await p.getByRole('button',{name:'Show pieces already in your world',exact:true}).getAttribute('aria-pressed'),'true');
  await p.getByRole('button',{name:'Show pieces already in your world',exact:true}).click();
  checks.push(`${label}:curated-collections-and-placed-filter-no-auto-placement`);
  await p.getByRole('button',{name:'Save & play',exact:true}).click();
  const fixture=await p.evaluate(()=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!));
  const id='11111111-1111-4111-8111-111111111111';
  fixture.objects.push({id,assetId:'furniture-kit/tableCoffee',name:'QA writing table',x:3,y:0,z:3,rotation:0,scale:2,behavior:'solid',target:''});
  await p.evaluate(value=>localStorage.setItem('ctrl-habitat-test-v1',JSON.stringify(value)),fixture);
  await p.reload({waitUntil:'domcontentloaded'});await p.waitForFunction(()=>document.documentElement.dataset.ctrlHouseReady==='true');
  await p.getByRole('button',{name:'Perabot',exact:true}).click();if(mobile)await p.getByRole('button',{name:/Your pieces|Selected piece/}).click();
  await p.getByRole('combobox',{name:'Placed objects',exact:true}).selectOption(id);
  await p.getByRole('button',{name:'Face 90 degrees',exact:true}).click();
  await p.getByRole('button',{name:'Grand size, 3 times original',exact:true}).click();
  assert.equal(await p.getByRole('button',{name:'Face 90 degrees',exact:true}).getAttribute('aria-pressed'),'true');
  assert.equal(await p.getByRole('button',{name:'Grand size, 3 times original',exact:true}).getAttribute('aria-pressed'),'true');
  await p.screenshot({path:`${dir}/inspector-${label}.png`});
  await p.getByRole('button',{name:'Save & play',exact:true}).click();
  await p.reload({waitUntil:'domcontentloaded'});await p.waitForFunction(()=>document.documentElement.dataset.ctrlHouseReady==='true');
  const saved=await p.evaluate(objectId=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!).objects.find((o:{id:string})=>o.id===objectId),id);
  assert.equal(saved.scale,3);assert(Math.abs(saved.rotation-Math.PI/2)<.00001);
  checks.push(`${label}:visual-size-turn-presets-save-and-reload`);
  await p.screenshot({path:`${dir}/world-${label}.png`});
  assert(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
  await context.close();
 }
 assert.deepEqual(errors,[]);await writeFile(`${dir}/report.json`,JSON.stringify({origin,checks,errors,mobile:'Chromium touch emulation, not physical device'},null,2));
 console.log('HABITAT_BEAUTY_PASS',checks);
}finally{await browser.close();}

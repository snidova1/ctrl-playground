 await p.getByRole('button',{name:/Open door$/}).click();await p.getByRole('button',{name:/Close door$/}).waitFor();checks.push('real-door-can-open-without-wallet');
 await p.getByRole('button',{name:'Bangun rumah',exact:true}).click();await p.getByRole('button',{name:'Add room north',exact:true}).click();await p.getByRole('button',{name:'Remove room north',exact:true}).waitFor();await p.getByRole('button',{name:'Undo house change',exact:true}).click();await p.getByRole('button',{name:'Add room north',exact:true}).waitFor();await p.getByRole('button',{name:'Redo house change',exact:true}).click();await p.getByRole('button',{name:'Remove room north',exact:true}).waitFor();await p.screenshot({path:`${dir}/build-phone.png`});await p.getByRole('button',{name:'Save house',exact:true}).click();
 const saved=await p.evaluate(()=>localStorage.getItem('ctrl-habitat-test-v1'));assert(saved);assert.equal(JSON.parse(saved).objects.find((o:{assetId:string})=>o.assetId==='habitat-house').house.cells.length,7);assert(Object.values(JSON.parse(saved).states).some((s:unknown)=>!!s&&(s as {active:boolean}).active));
 await p.reload({waitUntil:'domcontentloaded'});await p.waitForFunction(()=>Number(document.documentElement.dataset.ctrlAvatarMeshCount)>0&&document.documentElement.dataset.ctrlHouseReady==='true');assert.equal(await p.evaluate(()=>localStorage.getItem('ctrl-habitat-test-v1')),saved);await p.getByRole('button',{name:'Bangun rumah',exact:true}).click();await p.getByRole('button',{name:'Remove room north',exact:true}).waitFor();await p.getByRole('button',{name:'Cancel house changes',exact:true}).click();checks.push('house-modules-undo-redo-local-save-reload-no-backend');
 await p.getByRole('button',{name:'Perabot',exact:true}).click();await p.getByRole('textbox',{name:'Search assets',exact:true}).fill('Chair');await p.getByRole('button',{name:'Add Chair',exact:true}).first().click();await placeAimedFurniture(p,cdp);await p.getByRole('button',{name:'Save & play',exact:true}).click();const furnished=await p.evaluate(()=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!));assert.equal(furnished.objects.length,JSON.parse(saved).objects.length+1);checks.push('real-furniture-catalog-add-and-local-save');
 assert.deepEqual(apiRequests,[]);assert.deepEqual(errors,[]);await p.screenshot({path:`${dir}/saved-phone.png`});await context.close();

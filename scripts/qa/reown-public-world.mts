const origin=process.env.CTRL_QA_ORIGIN??'http://127.0.0.1:3200',dir='test-results/reown-public-world';await mkdir(dir,{recursive:true});const browser=await chromium.launch({executablePath:'/home/celeng/.cache/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell',args:['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-dev-shm-usage']});const context=await browser.newContext({baseURL:origin,viewport:{width:1280,height:900}}),p=await context.newPage();p.setDefaultTimeout(120000);const errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));
try{const network=await(await p.request.get('/api/network')).json();assert.equal(network.walletConnectProjectId,'e1703181bc42b7be7b2054f2348099ae');await installSignedWallet(p,network.chainId);await p.goto('/',{waitUntil:'domcontentloaded'});await p.locator('.cg-lobby[data-guest-id]').waitFor();await p.getByRole('button',{name:/Connect wallet ↗/}).click();const dialog=p.locator('.cg-dialog');await dialog.getByRole('button',{name:'Connect wallet',exact:true}).click();await p.locator('w3m-modal.open').waitFor({state:'visible'});await p.locator('w3m-modal').getByText('WalletConnect',{exact:true}).first().waitFor();await p.waitForFunction("(()=>{const roots=[document];while(roots.length){for(const e of roots.pop().querySelectorAll('*')){if(e.tagName.toLowerCase()==='wui-qr-code'&&(e.uri||e.getAttribute('uri')))return true;if(e.shadowRoot)roots.push(e.shadowRoot);}}return false;})()");await p.waitForTimeout(800);await p.screenshot({path:`${dir}/real-appkit-modal.png`});await p.keyboard.press('Escape');await p.locator('w3m-modal.open').waitFor({state:'hidden'});await dialog.waitFor({state:'visible'});await dialog.getByRole('button',{name:'Use browser wallet',exact:true}).click();await dialog.getByRole('button',{name:'Sign in to CTRL',exact:true}).click();const creator=p.getByRole('form',{name:'Public World avatar',exact:true});await creator.waitFor();await creator.getByRole('combobox',{name:'Avatar character',exact:true}).selectOption('female');await creator.getByRole('textbox',{name:'Avatar name',exact:true}).fill('Ayu Prameswari');await creator.getByRole('button',{name:'Apply Evening lace',exact:true}).click();await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarWardrobe==='airi-a-inner'&&document.documentElement.dataset.ctrlAvatarHairStyle==='airi-a-short-bob');await p.getByRole('button',{name:'Save avatar & enter Public World',exact:true}).click();await p.waitForURL('**/public-world');await p.locator('.wg-world[data-ready="true"]').waitFor();await p.waitForFunction(()=>document.querySelector('canvas')?.getAttribute('data-avatar-ready')==='true');const before=await(await p.request.get('/api/habitat/profile')).json();assert.equal(before.profile.appearance.lookId,'airi');assert.equal(before.profile.appearance.wardrobeId,'airi-a-inner');assert.equal(before.profile.appearance.hairStyleId,'airi-a-short-bob');assert.deepEqual(JSON.parse(await p.locator('.wg-world').getAttribute('data-player-appearance')??'{}'),before.profile.appearance);await p.reload({waitUntil:'domcontentloaded'});await p.locator('.wg-world[data-ready="true"]').waitFor();const after=await(await p.request.get('/api/habitat/profile')).json();assert.deepEqual(after.profile.appearance,before.profile.appearance);await p.getByRole('button',{name:'Places',exact:true}).click();await p.getByRole('button',{name:/^Lantern Market/}).click();await p.waitForFunction(()=>document.querySelector('.wg-world')?.getAttribute('data-district')==='lantern-market');await p.waitForFunction(()=>document.querySelector('canvas')?.getAttribute('data-avatar-ready')==='true');await p.waitForTimeout(1200);await p.screenshot({path:`${dir}/signed-avatar-market.png`});assert.deepEqual(errors,[]);await writeFile(`${dir}/report.json`,JSON.stringify({origin,realReownModal:true,projectId:network.walletConnectProjectId,escapePreservesSignIn:true,signedAuth:'isolated browser wallet with real backend nonce/signature verification',presetSaveAndReload:true,sameAvatarInPublicWorld:true,districtTravel:true,errors},null,2));console.log('REOWN_PUBLIC_WORLD_PASS');}catch(e){await p.screenshot({path:`${dir}/failure.png`});console.log('DIAG',await p.locator('body').innerText());throw e;}finally{await context.close();await browser.close();}

import {chromium} from '@playwright/test';
import {installSignedWallet} from '../../tests/browser/helpers/wallet';
import {mkdir,writeFile} from 'node:fs/promises';
import assert from 'node:assert/strict';
const dir='test-results/avatar-modular-habitat';await mkdir(dir,{recursive:true});
const origin=process.env.CTRL_AVATAR_QA_ORIGIN??'http://127.0.0.1:3173';
const b=await chromium.launch({executablePath:'/home/celeng/.cache/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell',args:['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-dev-shm-usage']});
const results=[];
try{
 for(const spec of [
  {family:'drophunter',hair:'straight',top:'lightshirt',bottom:'waistshorts',shoes:'thinshoe',outer:'shortjacket',accessory:'hipbelt'},
  {family:'neurohacker',hair:'short',top:'simpleshirt',bottom:'streetpants',shoes:'simpleshoes',outer:'longjacket',accessory:'beltandbag'},
 ].filter(spec=>!process.env.CTRL_AVATAR_QA_FAMILY||spec.family===process.env.CTRL_AVATAR_QA_FAMILY)){
  const context=await b.newContext({baseURL:origin,viewport:{width:1280,height:900}});const p=await context.newPage();p.setDefaultTimeout(90000);const errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));

  try{
   const network=await(await p.request.get('/api/network')).json();await installSignedWallet(p,network.chainId);await p.goto('/habitat',{waitUntil:'domcontentloaded'});await p.locator('.wallet-options').getByRole('button',{name:'Connect wallet',exact:true}).click();await p.getByRole('button',{name:'Sign in to Habitat',exact:true}).click();
   const creator=p.getByRole('region',{name:'3D character creator'});await creator.waitFor();await p.waitForFunction(()=>document.querySelector('.hb-avatar-preview')?.getAttribute('data-avatar-ready')==='true');
   await creator.getByRole('combobox',{name:'Body & outfit model',exact:true}).selectOption(`modular:${spec.family}`);
   for(const [key,label]of [['hair','Hairstyle'],['top','Top'],['bottom','Bottom'],['shoes','Shoes'],['outer','Outer layer'],['accessory','Native accessory']] as const)await creator.getByRole('combobox',{name:label,exact:true}).selectOption(spec[key]);
   await p.waitForFunction(spec=>{const d=document.documentElement.dataset;return document.querySelector('.hb-avatar-preview')?.getAttribute('data-avatar-ready')==='true'&&d.ctrlAvatarModularFamily===spec.family&&Object.entries(spec).filter(([k])=>k!=='family').every(([k,id])=>JSON.parse(d.ctrlAvatarModularParts??'[]').includes(`${k}/${id}`));},spec);
   await creator.getByRole('textbox',{name:'Name',exact:true}).fill(spec.family==='drophunter'?'Native Drophunter':'Native Neurohacker');await p.screenshot({path:`${dir}/${spec.family}-creator.png`});const instance=await p.evaluate(()=>document.documentElement.dataset.ctrlAvatarInstance);
   await p.getByRole('button',{name:'Enter my world draft',exact:true}).click();await p.getByRole('button',{name:'Build my world +',exact:true}).waitFor();
   await p.waitForFunction(({spec,instance})=>{const d=document.documentElement.dataset;return !document.querySelector('.hb-avatar-preview')&&!!d.ctrlAvatarInstance&&d.ctrlAvatarInstance!==instance&&d.ctrlAvatarModularFamily===spec.family&&Object.entries(spec).filter(([k])=>k!=='family').every(([k,id])=>JSON.parse(d.ctrlAvatarModularParts??'[]').includes(`${k}/${id}`));},{spec,instance});
   await p.waitForTimeout(800);await p.screenshot({path:`${dir}/${spec.family}-gameplay.png`});const before=await(await p.request.get('/api/habitat/state')).json();assert.deepEqual(before.profile.appearance.modular,spec);
   await p.keyboard.down('w');await p.waitForTimeout(600);await p.keyboard.up('w');await p.screenshot({path:`${dir}/${spec.family}-walk.png`});
   await p.getByRole('button',{name:'Wave hello',exact:true}).click();await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarGesture==='interact');await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarGesture==='none');
   await p.getByRole('button',{name:'Cheer',exact:true}).click();await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarGesture==='victory');await p.keyboard.down('w');await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarGesture==='none'&&document.documentElement.dataset.ctrlAvatarState==='Walk');await p.keyboard.up('w');
   assert.deepEqual((await(await p.request.get('/api/habitat/state')).json()).profile.appearance,before.profile.appearance,'Emotes do not mutate saved appearance');await p.reload({waitUntil:'domcontentloaded'});await p.getByRole('button',{name:'Build my world +',exact:true}).waitFor();await p.waitForFunction(spec=>{const d=document.documentElement.dataset;return !!d.ctrlAvatarInstance&&d.ctrlAvatarModularFamily===spec.family&&Object.entries(spec).filter(([k])=>k!=='family').every(([k,id])=>JSON.parse(d.ctrlAvatarModularParts??'[]').includes(`${k}/${id}`));},spec);
   const after=await(await p.request.get('/api/habitat/state')).json();assert.deepEqual(after.profile.appearance,before.profile.appearance);assert.deepEqual(errors,[]);
   await p.setViewportSize({width:390,height:844});const cdp=await context.newCDPSession(p);await cdp.send('Emulation.setTouchEmulationEnabled',{enabled:true,maxTouchPoints:5});await p.reload({waitUntil:'domcontentloaded'});await p.getByRole('button',{name:'Build my world +',exact:true}).waitFor();await p.waitForFunction(spec=>document.documentElement.dataset.ctrlAvatarModularFamily===spec.family&&JSON.parse(document.documentElement.dataset.ctrlAvatarModularParts??'[]').includes(`accessory/${spec.accessory}`),spec);await p.locator('.hb-analog-stick').waitFor({state:'visible'});assert(await p.evaluate(()=>matchMedia('(pointer:coarse)').matches));const stick=await p.locator('.hb-analog-stick').boundingBox();assert(stick);const point={x:stick.x+stick.width/2,y:stick.y+stick.height/2};await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[point]});await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{...point,y:point.y-26}]});await p.waitForTimeout(400);await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});const wave=await p.getByRole('button',{name:'Wave hello',exact:true}).boundingBox();assert(wave&&wave.height>=44&&wave.width>=44);await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x:wave.x+wave.width/2,y:wave.y+wave.height/2}]});await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarGesture==='interact');await p.screenshot({path:`${dir}/${spec.family}-phone-gameplay.png`});await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarGesture==='none');assert(await p.evaluate(()=>document.documentElement.scrollWidth<=innerWidth));
   results.push({family:spec.family,appearance:after.profile.appearance,reloadPreserved:true,errors});console.log('PASS SIGNED HABITAT',spec.family,'creator -> gameplay fresh instance -> WASD -> reload, all seven native fields persisted');
  }catch(e){console.log('DIAG',JSON.stringify(await p.evaluate(()=>({data:{...document.documentElement.dataset},alerts:[...document.querySelectorAll('[role=alert]')].map(e=>e.textContent)}))));await p.screenshot({path:`${dir}/${spec.family}-failure.png`,fullPage:true});throw e;}finally{await context.close();}
 }
 await writeFile(`${dir}/report.json`,JSON.stringify(results,null,2));
}finally{await b.close();}

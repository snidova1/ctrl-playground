const origin=process.env.CTRL_QA_ORIGIN??'http://127.0.0.1:3243',dir=`test-results/cozy-life-server/${new URL(origin).hostname.includes('127.0.0.1')?'local':'live'}`;
await mkdir(dir,{recursive:true});const checks:string[]=[],sessions:Awaited<ReturnType<typeof createCozyLifeQaSession>>[]=[];
const record=(s:string)=>{checks.push(s);console.log('LIFE_SERVER_CHECK',s);};
const sleep=(ms:number)=>new Promise(r=>setTimeout(r,ms));
try{
 const anonymous=await fetch(origin+'/api/cozy-life');assert.equal(anonymous.status,401);record('anonymous-cannot-read-or-mutate-persistent-inventory');
 const a=await createCozyLifeQaSession(origin),b=await createCozyLifeQaSession(origin);sessions.push(a,b);
 const read=async(s:typeof a)=>{const r=await s.get('cozy-life');assert.equal(r.status,200,await r.clone().text());return await r.json() as LifeResponse;};
 let ar=await read(a),br=await read(b);assert.notEqual(ar.profileId,br.profileId);assert.equal(ar.state.revision,0);assert.equal(ar.state.inventory['turnip-seed'],4);
 const act=async(s:typeof a,response:LifeResponse,action:LifeAction|BarterAction|ServingAction)=>{const r=await s.post('cozy-life',{revision:response.state.revision,action});assert.equal(r.status,200,await r.clone().text());return await r.json() as LifeResponse;};
 const created=await a.post('habitat/profile',{name:'Cozy QA Garden',character:'female'});assert.equal(created.status,200,await created.clone().text());
 const home=await created.json() as {world:{id:string;objects:WorldObject[]}};assert(home.world?.id);
 const bp=await b.post('habitat/public-profile',{name:'Cozy QA Guest',character:'male'});assert.equal(bp.status,200);
 const gardenPoint=findLifePlacement(home.world.objects,'garden');assert(gardenPoint);
 ar=await act(a,ar,{type:'place-garden',...gardenPoint});assert.deepEqual(ar.state.gardenAnchor,gardenPoint);
 const ownerView=await a.get('cozy-life/world?worldId='+home.world.id);assert.equal(ownerView.status,200);const sanitized=await ownerView.json() as Record<string,unknown>;assert(sanitized.gardenAnchor);assert(!('inventory'in sanitized));
 const forbidden=await b.get('cozy-life/world?worldId='+home.world.id);assert.equal(forbidden.status,403);
 const noHome=await b.post('cozy-life',{revision:br.state.revision,action:{type:'place-garden',...gardenPoint}});assert.equal(noHome.status,403);
 const overlap=await a.post('habitat/save',{worldId:home.world.id,revision:0,objects:[{id:crypto.randomUUID(),assetId:'furniture-kit/plantSmall2',name:'QA overlap',behavior:'decoration',x:gardenPoint.x,z:gardenPoint.z,y:0,rotation:0,scale:1,target:''}]});assert.equal(overlap.status,422);assert.equal((await overlap.json() as {code:string}).code,'COZY_LAYOUT_BLOCKED');
 record('offchain-private-qa-home-opt-in-garden-owner-view-private-acl-no-home-denial-and-builder-overlap-rejected-no-key-transaction');
 const stale=ar.state.revision;
 ar=await act(a,ar,{type:'plant',bedId:0,cropId:'turnip'});ar=await act(a,ar,{type:'water',bedId:0});
 ar=await act(a,ar,{type:'plant',bedId:1,cropId:'tomato'});ar=await act(a,ar,{type:'water',bedId:1});
 ar=await act(a,ar,{type:'plant',bedId:2,cropId:'herb'});ar=await act(a,ar,{type:'water',bedId:2});
 ar=await act(a,ar,{type:'plant',bedId:3,cropId:'turnip'});ar=await act(a,ar,{type:'water',bedId:3});
 const tooEarly=await a.post('cozy-life',{revision:ar.state.revision,action:{type:'harvest',bedId:1}});assert.equal(tooEarly.status,422);
 const conflict=await a.post('cozy-life',{revision:stale,action:{type:'cast'}});assert.equal(conflict.status,409);
 const forged=await a.post('cozy-life',{revision:ar.state.revision,action:{type:'water',bedId:0},now:Date.now()+9999999,inventory:{turnip:999}});assert.equal(forged.status,422);
 record('server-plants-waters-enforces-real-growth-time-and-rejects-forged-time-and-stale-revisions');
 ar=await act(a,ar,{type:'offer-create',give:{itemId:'turnip-seed',quantity:1},want:{itemId:'herb-seed',quantity:1}});
 const offer=ar.offerings.find(o=>o.mine)!;assert(offer);assert.equal(ar.state.inventory['turnip-seed'],1);
 const self=await a.post('cozy-life',{revision:ar.state.revision,action:{type:'offer-accept',offerId:offer.id}});assert.equal(self.status,403);
 br=await read(b);assert(br.offerings.some(o=>o.id===offer.id&&!o.mine));br=await act(b,br,{type:'offer-accept',offerId:offer.id});
 assert.equal(br.state.inventory['turnip-seed'],5);assert.equal(br.state.inventory['herb-seed'],3);
 ar=await read(a);assert.equal(ar.state.inventory['herb-seed'],4);
 const duplicate=await b.post('cozy-life',{revision:br.state.revision,action:{type:'offer-accept',offerId:offer.id}});assert([404,409].includes(duplicate.status));
 const beforeCancel=ar.state.inventory['tomato-seed'];ar=await act(a,ar,{type:'offer-create',give:{itemId:'tomato-seed',quantity:1},want:{itemId:'herb-seed',quantity:1}});
 const cancel=ar.offerings.find(o=>o.mine)!;ar=await act(a,ar,{type:'offer-cancel',offerId:cancel.id});assert.equal(ar.state.inventory['tomato-seed'],beforeCancel);
 record('two-real-wallet-sessions-barter-escrow-accept-single-use-and-cancel-refund');
 // Fish with real server time/randomness. No fixture inventory, clock override, or DB edits.
 let castCount=0;
 while((ar.state.inventory.driftwood??0)<3&&(ar.state.inventory.clay??0)<2&&castCount<32){
  const wait=ar.state.nextCastAt-ar.serverNow;if(wait>0)await sleep(wait+150);
  ar=await read(a);ar=await act(a,ar,{type:'cast'});
  const early=await a.post('cozy-life',{revision:ar.state.revision,action:{type:'reel'}});assert.equal(early.status,422);
  await sleep(Math.max(0,ar.state.fishing!.biteAt-ar.serverNow)+200);
  const count=ar.state.stats.fishCaught;ar=await act(a,ar,{type:'reel'});assert.equal(ar.state.stats.fishCaught,count+1);castCount++;
 }
 record(`real-timed-fishing-catches-${castCount}`);
 const readyAt=Math.max(...ar.state.beds.map(b=>b.readyAt??0));await sleep(Math.max(0,readyAt-ar.serverNow)+200);
 ar=await read(a);for(const bedId of [0,1,2,3])ar=await act(a,ar,{type:'harvest',bedId});
 assert.equal(ar.state.stats.harvests,4);assert.equal(ar.state.inventory.turnip,CROPS.turnip.yield*2);
 ar=await act(a,ar,{type:'cook',recipeId:'garden-soup'});assert.equal(ar.state.inventory['garden-soup'],1);assert.equal(ar.state.inventory.turnip,4);assert.equal(ar.state.inventory.tomato,3);
 const recipeId=(ar.state.inventory.driftwood??0)>=3?'wooden-bench':'flower-pot';assert((ar.state.inventory.driftwood??0)>=3||(ar.state.inventory.clay??0)>=2,'real fishing must supply craft inputs');
 ar=await act(a,ar,{type:'craft',recipeId});assert.equal(ar.state.inventory[RECIPES[recipeId].output],1);assert.equal(ar.state.stats.itemsCrafted,1);
 record('real-server-time-harvest-cooking-and-crafting-debit-inputs-and-persist-output');
 ar=await act(a,ar,{type:'eat',itemId:'garden-soup'});assert.equal(ar.state.inventory['garden-soup']??0,0);assert.equal(ar.state.mealsEaten,1);
 ar=await act(a,ar,{type:'cook',recipeId:'garden-soup'});ar=await act(a,ar,{type:'serve',itemId:'garden-soup'});assert.equal(ar.state.inventory['garden-soup']??0,0);const serving=ar.servings?.find(m=>m.mine);assert(serving);
 br=await read(b);assert(br.servings?.some(m=>m.id===serving.id));br=await act(b,br,{type:'eat-serving',servingId:serving.id});assert.equal(br.state.mealsEaten,1);
 const repeatedMeal=await a.post('cozy-life',{revision:ar.state.revision,action:{type:'eat-serving',servingId:serving.id}});assert([404,409].includes(repeatedMeal.status));ar=await read(a);
 const point=findLifePlacement(home.world.objects,recipeId,ar.state.decorations,ar.state.gardenAnchor);assert(point);
 ar=await act(a,ar,{type:'place-craft',itemId:recipeId,...point,rotation:0});assert.equal(ar.state.inventory[recipeId]??0,0);const decoration=ar.state.decorations?.[0];assert(decoration);
 ar=await act(a,ar,{type:'remove-craft',id:decoration.id});assert.equal(ar.state.inventory[recipeId],1);assert.equal(ar.state.decorations?.length,0);
 const replay=await a.post('cozy-life',{revision:ar.state.revision,action:{type:'remove-craft',id:decoration.id}});assert.equal(replay.status,422);
 ar=await act(a,ar,{type:'place-craft',itemId:recipeId,...point,rotation:0});assert.equal(ar.state.decorations?.length,1);
 record('real-eat-debit-cross-player-serving-single-consumption-crafted-placement-and-single-refund');
 const previousTotal=ar.community.totalItems;
 ar=await act(a,ar,{type:'contribute',itemId:'turnip',quantity:1});assert.equal(ar.state.inventory.turnip,1);assert.equal(ar.state.contributions.turnip,1);assert(ar.community.totalItems>=previousTotal+1);
 br=await read(b);assert(br.community.totalItems>=ar.community.totalItems);assert.equal(br.state.contributions.turnip??0,0);
 const persisted=await read(a);assert.equal(persisted.state.revision,ar.state.revision);assert.deepEqual(persisted.state.inventory,ar.state.inventory);record('personal-save-reload-and-real-shared-community-aggregate');
 await writeFile(`${dir}/report.json`,JSON.stringify({origin,checks,errors:[],serverTime:true,unfundedWallets:sessions.map(s=>s.address)},null,2));console.log('COZY_LIFE_SERVER_QA_PASS',checks);
}finally{for(const s of sessions)await s.logout().catch(()=>{});}

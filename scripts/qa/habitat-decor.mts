import {chromium} from '@playwright/test';
import assert from 'node:assert/strict';
import {mkdir,writeFile} from 'node:fs/promises';
import {aimAtValidFloor} from './helpers/furniture-aim';
const origin=process.env.CTRL_QA_ORIGIN??'http://127.0.0.1:3242',dir=`test-results/habitat-decor/${origin.includes('127.0.0.1')?'source':'live'}`;
await mkdir(dir,{recursive:true});
const browser=await chromium.launch({executablePath:'/home/celeng/.cache/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell',args:['--no-sandbox','--use-angle=swiftshader','--enable-unsafe-swiftshader','--disable-dev-shm-usage']});
try{
 const context=await browser.newContext({viewport:{width:390,height:760},isMobile:true,hasTouch:true});const p=await context.newPage();p.setDefaultTimeout(45000);const errors:string[]=[];p.on('pageerror',e=>errors.push(e.message));
 const ready=()=>p.waitForFunction(()=>document.documentElement.dataset.ctrlHouseReady==='true'&&Number(document.documentElement.dataset.ctrlAvatarMeshCount)>0);
 await p.goto(origin+'/habitat-test',{waitUntil:'domcontentloaded'});await ready();await p.getByRole('button',{name:'Perabot',exact:true}).click();await p.getByRole('button',{name:'Save & play',exact:true}).click();
 const fixture=await p.evaluate(()=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!));
 fixture.objects=fixture.objects.filter((o:{assetId:string})=>o.assetId==='habitat-house'||o.assetId.startsWith('house-'));
 await p.evaluate(value=>localStorage.setItem('ctrl-habitat-test-v1',JSON.stringify(value)),fixture);await p.reload({waitUntil:'domcontentloaded'});await ready();
 const choose=async()=>{await p.getByRole('button',{name:'Perabot',exact:true}).click();await p.getByRole('textbox',{name:'Search assets',exact:true}).fill('Books');await p.getByRole('button',{name:'Add Books',exact:true}).click();};
 await choose();const cdp=await context.newCDPSession(p),replay:Array<{method:string;params:unknown}>=[];
 const recorder={send:async(method:string,params:unknown)=>{replay.push({method,params});return cdp.send(method as never,params as never);}};
 await aimAtValidFloor(p,recorder as unknown as typeof cdp);
 const data=await p.evaluate(()=>({camera:JSON.parse(document.documentElement.dataset.ctrlHouseCamera!),x:Number(document.querySelector<HTMLElement>('.hb-placement')!.dataset.placementX),z:Number(document.querySelector<HTMLElement>('.hb-placement')!.dataset.placementZ)}));
 const height=.23*4,t=(data.camera.y-height)/data.camera.y;
 fixture.objects.push({id:'22222222-2222-4222-8222-222222222222',assetId:'furniture-kit/tableCoffee',name:'Tabletop test',x:data.camera.x+(data.x-data.camera.x)*t,y:0,z:data.camera.z+(data.z-data.camera.z)*t,rotation:0,scale:4,behavior:'solid',target:''});
 await p.evaluate(value=>localStorage.setItem('ctrl-habitat-test-v1',JSON.stringify(value)),fixture);await p.reload({waitUntil:'domcontentloaded'});await ready();await choose();
 for(const call of replay)await cdp.send(call.method as never,call.params as never);
 await p.waitForFunction(()=>document.querySelector('.hb-placement-status')?.textContent?.includes('Di atas meja')).catch(async error=>{console.log('TABLETOP_FAILURE',fixture.objects,await p.locator('.hb-placement-status').innerText(),await p.evaluate(()=>({camera:document.documentElement.dataset.ctrlHouseCamera,ghost:document.documentElement.dataset.ctrlFurnitureGhost})));await p.screenshot({path:`${dir}/failure.png`});throw error;});
 await p.screenshot({path:`${dir}/tabletop-ghost-phone.png`});
 await p.getByRole('button',{name:'Pasang perabot',exact:true}).click();await p.getByRole('button',{name:'Save & play',exact:true}).click();
 await p.reload({waitUntil:'domcontentloaded'});await ready();
 const saved=await p.evaluate(()=>JSON.parse(localStorage.getItem('ctrl-habitat-test-v1')!).objects.find((o:{assetId:string})=>o.assetId==='furniture-kit/books'));
 assert(saved);assert(Math.abs(saved.y-height)<1e-8);assert.deepEqual(errors,[]);
 await p.screenshot({path:`${dir}/tabletop-saved-phone.png`});await writeFile(`${dir}/report.json`,JSON.stringify({origin,saved,errors,check:'camera-targeted-books-on-table-confirm-and-persist-after-reload'},null,2));console.log('TABLETOP_BROWSER_PASS',saved);
}finally{await browser.close();}

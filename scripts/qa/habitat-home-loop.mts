import {chromium,type Page} from '@playwright/test';
import {mkdir,writeFile} from 'node:fs/promises';
import {resolve} from 'node:path';
import assert from 'node:assert/strict';
const origin=process.env.CTRL_QA_ORIGIN??'http://127.0.0.1:3251',label=process.env.CTRL_LOOP_LABEL??'candidate';
const dir=resolve('test-results/habitat-home-loop',label);await mkdir(dir,{recursive:true});
const browser=await chromium.launch({headless:true,executablePath:process.env.CTRL_QA_CHROME??'/home/celeng/.cache/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-linux64/chrome-headless-shell',args:['--no-sandbox','--disable-dev-shm-usage','--enable-unsafe-swiftshader','--use-gl=angle','--use-angle=swiftshader']});
let active:Page|undefined;const results:unknown[]=[],errors:string[]=[];
try{for(const mobile of (process.env.CTRL_LOOP_MODE==='desktop'?[false]:process.env.CTRL_LOOP_MODE==='phone'?[true]:[false,true])){
 const mode=mobile?'phone':'desktop',context=await browser.newContext({baseURL:origin,viewport:{width:mobile?390:1000,height:760},hasTouch:mobile,isMobile:mobile}),p=await context.newPage();active=p;p.setDefaultTimeout(90_000);p.on('pageerror',e=>errors.push(e.message));
 const screenshots:Record<string,unknown>={};let boundsSequence=0;
 // tsx's named nested callbacks need this only in the test page's init world.
 await p.addInitScript('globalThis.__name=(value)=>value;');
 await p.addInitScript(()=>{document.addEventListener('DOMContentLoaded',()=>{document.documentElement.dataset.ctrlCaptureMotion='true';const w=window as unknown as {motionLog:unknown[];loopPhase:string};w.motionLog=[];w.loopPhase='load';let last=0;function sample(){const text=document.documentElement.dataset.ctrlAvatarPose;if(text){const pose=JSON.parse(text);if(pose.time!==last){last=pose.time;w.motionLog.push({...pose,phase:w.loopPhase,camera:JSON.parse(document.documentElement.dataset.ctrlHouseCamera??'null'),shell:document.documentElement.dataset.ctrlHouseShellVisible,roof:document.documentElement.dataset.ctrlHouseRoofVisible});}}requestAnimationFrame(sample);}requestAnimationFrame(sample);});});
 const response=await p.goto('/habitat-test',{waitUntil:'domcontentloaded'});assert.equal(response?.status(),200);await p.waitForFunction(()=>document.documentElement.dataset.ctrlHouseReady==='true'&&Number(document.documentElement.dataset.ctrlAvatarMeshCount)>0);assert.equal(await p.evaluate(()=>document.documentElement.dataset.entryArtPreview),'true','Exercise the freshly built source, not a stale server');
 const storage=await p.evaluate(()=>localStorage.getItem('ctrl-habitat-test-v1')),cdp=mobile?await context.newCDPSession(p):undefined;
 async function phase(name:string){await p.evaluate(v=>{(window as unknown as {loopPhase:string}).loopPhase=v;},name);}
 async function shot(name:string,wholeBody=false){let bounds:{min:number[];max:number[];screen:{minX:number;maxX:number;minY:number;maxY:number}}|undefined;for(let i=0;i<(wholeBody?40:1);i++){const nonce=String(++boundsSequence);await p.evaluate(v=>{document.documentElement.dataset.ctrlCaptureBoundsNonce=v;},nonce);await p.waitForFunction(v=>document.documentElement.dataset.ctrlAvatarBoundsNonce===v,nonce);bounds=await p.evaluate(()=>JSON.parse(document.documentElement.dataset.ctrlAvatarBounds!));if(!wholeBody||(bounds!.screen.minX>=-.97&&bounds!.screen.maxX<=.97&&bounds!.screen.minY>=-.97&&bounds!.screen.maxY<=.97))break;}if(wholeBody){assert(bounds);assert(bounds.screen.minX>=-.97&&bounds.screen.maxX<=.97&&bounds.screen.minY>=-.97&&bounds.screen.maxY<=.97,`Whole posed body must fit the ${mode} view in ${name}: ${JSON.stringify(bounds.screen)}`);assert(bounds.min[1]>=-.012,`Posed skin must not pierce the floor: ${bounds.min[1]}`);}screenshots[name]={bounds,...await p.evaluate(()=>({location:document.querySelector<HTMLElement>('.hb-house-location')?.dataset,pose:JSON.parse(document.documentElement.dataset.ctrlAvatarPose!),camera:JSON.parse(document.documentElement.dataset.ctrlHouseCamera!)}))};await p.screenshot({path:resolve(dir,`${mode}-${name}.png`),timeout:90_000});}
 async function drag(dx:number){const x=mobile?195:500,y=300;if(cdp){await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x,y,id:8}]});await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x:x+dx,y,id:8}]});await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});}else{await p.mouse.move(x,y);await p.mouse.down();await p.mouse.move(x+dx,y,{steps:8});await p.mouse.up();}}
 async function move(key:string,axes:{x:number;z:number},done:()=>boolean){if(cdp){const b=await p.getByRole('group',{name:'Analog movement control',exact:true}).boundingBox();assert(b);const x=b.x+b.width/2,y=b.y+b.height/2;await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x,y,id:9}]});await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x:x+axes.x*36,y:y+axes.z*36,id:9}]});}else await p.keyboard.down(key);try{await p.waitForFunction(done,{},{timeout:90_000});}finally{if(cdp)await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});else await p.keyboard.up(key);}}
 async function action(label:RegExp){const b=p.getByRole('button',{name:label});await b.waitFor();if(mobile)await b.tap();else await p.keyboard.press('KeyE');}
 const waitDoor=(open:boolean)=>p.waitForFunction(v=>JSON.parse(document.documentElement.dataset.ctrlHouseDoorAngles??'[]').some((d:{angle:number})=>Math.abs(d.angle-(v?-Math.PI/2:0))<.015),open);
 await shot('outside');await drag(-86);await phase('enter');await action(/Open door$/);await waitDoor(true);
 await move('KeyW',{x:0,z:-1},()=>{const l=document.querySelector<HTMLElement>('.hb-house-location');return l?.dataset.houseInside==='true'&&Number(l.dataset.playerZ)<.65;});await shot('inside');
 // Turn toward the room with actual pointer/touch drags before shutting the door.
 await phase('orbit');for(let i=0;i<2;i++)await drag(157);
 // Slow touch/render feedback can carry the player closer to the bench than
 // the door. Re-approach with real controls; never assume the nearest prompt.
 if(!await p.getByRole('button',{name:/Close door$/}).count())await move('KeyD',{x:.4,z:0},()=>Array.from(document.querySelectorAll('.hb-interaction-actions button')).some(b=>b.textContent?.includes('Close door')));
 await action(/Close door$/);await waitDoor(false);await shot('door-closed',true);
 // Camera yaw is now -pi/2: A/left analog walks deeper into the room.
 await phase('approach-seat');await move('KeyA',{x:-1,z:0},()=>Array.from(document.querySelectorAll('.hb-interaction-actions button')).some(b=>b.textContent?.includes('Sit down')));
 await phase('sit');await action(/Sit down$/);await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarState==='Seated'&&document.documentElement.dataset.ctrlAvatarSeatContactSettled==='true');await shot('seated-side',true);
 await phase('stand');await action(/Stand up$/);await p.waitForFunction(()=>document.documentElement.dataset.ctrlAvatarState==='Idle'&&document.documentElement.dataset.ctrlAvatarSeatContactSettled===undefined);await shot('standing',true);
 await phase('exit');await move('KeyD',{x:1,z:0},()=>{const l=document.querySelector<HTMLElement>('.hb-house-location');return Number(l?.dataset.playerZ)>.6;});await action(/Open door$/);await waitDoor(true);await move('KeyD',{x:1,z:0},()=>{const l=document.querySelector<HTMLElement>('.hb-house-location');return l?.dataset.houseInside==='false'&&Number(l.dataset.playerZ)>2.4;});await shot('outside-again');
 const log=await p.evaluate(()=>(window as unknown as {motionLog:{root:number[];bones:{hips:number[]};state:string;phase:string;time:number;shell:string;roof:string}[]}).motionLog);await writeFile(resolve(dir,`${mode}-motion.json`),JSON.stringify(log,null,2));
 assert.equal(await p.evaluate(()=>localStorage.getItem('ctrl-habitat-test-v1')),storage,'Do not rewrite player layout');assert(log.every(f=>f.shell==='true'&&f.roof==='true'),'Keep shell and roof intact');const changes=log.slice(1).flatMap((f,i)=>['sit','stand'].includes(f.phase)?[{phase:f.phase,delta:Math.hypot(f.root[0]-log[i].root[0],f.root[2]-log[i].root[2]),hipY:Math.abs(f.bones.hips[1]-log[i].bones.hips[1]),dt:(f.time-log[i].time)/1000}]:[]);const worst=changes.reduce((a,b)=>b.delta>a.delta?b:a,{phase:'',delta:0,hipY:0,dt:0}),maxHipY=Math.max(...changes.map(v=>v.hipY));
 assert(log.some(f=>f.phase==='stand'&&f.state==='StandUp'),'Use a real standing transition');assert(worst.delta<=.30,`Visible avatar root jumps ${worst.delta.toFixed(3)}m in ${worst.phase}`);assert(maxHipY<.08,`Pelvis jumps vertically ${maxHipY.toFixed(3)}m`);
 results.push({mode,controls:mobile?'CDP touch orbit + analog + tap':'mouse orbit + WASD + E',frames:log.length,worstRootJump:worst,maxHipY,snapshots:screenshots});await context.close();active=undefined;
 }assert.deepEqual(errors,[]);console.log(JSON.stringify({origin,results,errors},null,2));}
catch(e){if(active){await active.screenshot({path:resolve(dir,'failure.png'),timeout:90_000}).catch(()=>{});await writeFile(resolve(dir,'failure.json'),JSON.stringify(await active.evaluate(()=>({body:document.body.innerText,location:document.querySelector('.hb-house-location')?.outerHTML,data:document.documentElement.dataset,log:(window as unknown as {motionLog:unknown[]}).motionLog})).catch(()=>({})),null,2));}throw e;}
finally{await writeFile(resolve(dir,'report.json'),JSON.stringify({origin,results,errors},null,2));await browser.close();}

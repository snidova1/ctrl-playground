# MOCK runs without paid credentials. DEVELOPMENT and PRODUCTION never silently
# replace unavailable live providers with fabricated results.
CTRL_MODE=mock
DEMO_AUTH_ENABLED=false
APP_ORIGIN=
# Orbio server secrets. Exact model ID must come from its current catalogue.
ORBIO_API_KEY=
ORBIO_MODEL=
ORBIO_BASE_URL=https://api.orbio.so
ORBIO_AGENT_ID=
# CTRL has no deployed token / lock address in this MVP.
CTRL_TOKEN_ADDRESS=
CTRL_LOCK_ADDRESS=
CTRL_CHAIN_ID=4663
CTRL_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Public WalletConnect project ID, not a private key.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# At least 32 unpredictable characters for authenticated worker ticks.
WORKER_SECRET=
# Reserved for a future OpenAI-compatible adapter; these values are not selected by this MVP.
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODEL=

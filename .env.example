# MOCK runs without paid credentials. DEVELOPMENT and PRODUCTION never silently
# replace unavailable live providers with fabricated results.
CTRL_MODE=mock
DEMO_AUTH_ENABLED=false
APP_ORIGIN=
# Orbio server secrets. Exact model ID must come from its current catalogue.
ORBIO_API_KEY=
ORBIO_MODEL=
ORBIO_BASE_URL=https://api.orbio.so
ORBIO_AGENT_ID=
# Disposable tCTRL fixture on chain 46630. Lock contract remains unconfigured.
CTRL_TOKEN_ADDRESS=0x6310796e59427b81845c5aa734e3f237504e9eb2
CTRL_LOCK_ADDRESS=
CTRL_CHAIN_ID=46630
CTRL_RPC_URL=https://robinhood-sepolia-rpc.publicnode.com
# Public WalletConnect project ID, not a private key.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# At least 32 unpredictable characters for authenticated worker ticks.
WORKER_SECRET=
# Reserved for a future OpenAI-compatible adapter; these values are not selected by this MVP.
OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_KEY=
OPENAI_COMPATIBLE_MODEL=

# CLI deployment only; never configure a signer in the web application.
CTRL_TESTNET_RPC_URL=https://robinhood-sepolia-rpc.publicnode.com
CTRL_TESTNET_WALLET_FILE=

# Live execution: shared daily ceiling; token release remains explicit.
CTRL_DAILY_COMPUTE_USD=1
CTRL_PUBLIC_RELEASE=false
